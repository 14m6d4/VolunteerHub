PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://mongo:27017/volunteerhub
# Number of reverse proxies in front of the API, used to resolve the real client
# IP for rate limiting. 0 for local development. Behind Cloudflare + Traefik
# (the production setup) this must be 2, or every client shares one bucket.
TRUST_PROXY=0
JWT_SECRET=replace-with-a-long-random-secret
# Optional bootstrap admin. Leave unset to skip admin seeding entirely.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
VAPID_PRIVATE_KEY=your-web-push-vapid-private-key
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
IMGBB_API_KEY=your-imgbb-api-key
