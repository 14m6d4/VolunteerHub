PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# PostgreSQL.
# The POSTGRES_* trio initialises the postgres container on first start and must
# agree with DATABASE_URL. The values below match the dev docker-compose.yml;
# in production use a strong password. Outside compose, swap the host
# `postgres` for `localhost`.
POSTGRES_USER=volunteerhub
POSTGRES_PASSWORD=volunteerhub
POSTGRES_DB=volunteerhub
DATABASE_URL=postgres://volunteerhub:volunteerhub@postgres:5432/volunteerhub
# Number of trusted reverse proxies directly in front of the API. 0 for local
# development, 1 in production where Traefik is the only hop we control.
# Do not raise this to cover Cloudflare: it appends to X-Forwarded-For rather
# than replacing it, so a higher count would trust a client-supplied entry.
# The real client IP comes from CF-Connecting-IP instead.
TRUST_PROXY=0
JWT_SECRET=replace-with-a-long-random-secret
# Optional bootstrap admin. Leave unset to skip admin seeding entirely.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
# Temporary: set to true to skip the sign-up email code (accounts start verified).
# Password reset still needs working email. Leave unset in normal operation.
DISABLE_EMAIL_OTP=
