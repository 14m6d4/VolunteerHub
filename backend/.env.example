PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://mongo:27017/volunteerhub
# Number of trusted reverse proxies directly in front of the API. 0 for local
# development, 1 in production where Traefik is the only hop we control.
# Do not raise this to cover Cloudflare: it appends to X-Forwarded-For rather
# than replacing it, so a higher count would trust a client-supplied entry.
# The real client IP comes from CF-Connecting-IP instead.
TRUST_PROXY=0
JWT_SECRET=replace-with-a-long-random-secret
# Optional bootstrap admin. Leave unset to skip admin seeding entirely.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
VAPID_PRIVATE_KEY=your-web-push-vapid-private-key
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
IMGBB_API_KEY=your-imgbb-api-key
